#include<stdio.h>
int main()
{
int marks;
printf("enter your marks");
scanf("%d",&marks);
if(marks < 0 || marks > 100)
printf("\nInvalid marks");
else if(marks >= 90)
printf("\nGrade O");
else if(marks >= 80)
printf("\nGrade A+");
else if(marks >= 70)
printf("\nGrade A");
else if(marks >= 60)
printf("\nGrade B");
else if(marks >= 50)
printf("\nGrade C");
else
printf("\nFail");
return 0;
}
